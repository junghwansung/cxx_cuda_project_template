#include "vector_kernel.cuh"
#include <cuda_runtime.h>
#include <stdexcept>

namespace {{ namespace_name }} {

namespace {

__global__ void vector_add_kernel(const float* a, const float* b, float* result, int n) {
    const int idx = static_cast<int>(blockIdx.x) * static_cast<int>(blockDim.x)
                    + static_cast<int>(threadIdx.x);
    if (idx < n) {
        result[idx] = a[idx] + b[idx];
    }
}

} // anonymous namespace

void vector_add(const std::vector<float>& a,
                const std::vector<float>& b,
                std::vector<float>& result) {
    if (a.size() != b.size()) {
        throw std::invalid_argument("Vectors must have the same size");
    }
    const int n = static_cast<int>(a.size());
    result.resize(static_cast<std::size_t>(n));

    float* d_a      = nullptr;
    float* d_b      = nullptr;
    float* d_result = nullptr;

    cudaMalloc(&d_a,      static_cast<std::size_t>(n) * sizeof(float));
    cudaMalloc(&d_b,      static_cast<std::size_t>(n) * sizeof(float));
    cudaMalloc(&d_result, static_cast<std::size_t>(n) * sizeof(float));

    cudaMemcpy(d_a, a.data(), static_cast<std::size_t>(n) * sizeof(float), cudaMemcpyHostToDevice);
    cudaMemcpy(d_b, b.data(), static_cast<std::size_t>(n) * sizeof(float), cudaMemcpyHostToDevice);

    constexpr int block_size = 256;
    const int grid_size = (n + block_size - 1) / block_size;
    vector_add_kernel<<<grid_size, block_size>>>(d_a, d_b, d_result, n);

    cudaMemcpy(result.data(), d_result, static_cast<std::size_t>(n) * sizeof(float), cudaMemcpyDeviceToHost);

    cudaFree(d_a);
    cudaFree(d_b);
    cudaFree(d_result);
}

} // namespace {{ namespace_name }}
