#include <gtest/gtest.h>
#include "math.hpp"
#include "utility.hpp"
#include "vector_kernel.cuh"

TEST(MathTest, Add) {
    EXPECT_EQ({{ namespace_name }}::add(1, 2), 3);
    EXPECT_EQ({{ namespace_name }}::add(-1, 1), 0);
}

TEST(MathTest, Multiply) {
    EXPECT_DOUBLE_EQ({{ namespace_name }}::multiply(2.0, 3.0), 6.0);
    EXPECT_DOUBLE_EQ({{ namespace_name }}::multiply(0.0, 5.0), 0.0);
}

TEST(UtilityTest, Greet) {
    EXPECT_EQ({{ namespace_name }}::greet("World"), "Hello, World!");
    EXPECT_EQ({{ namespace_name }}::greet(""), "Hello, !");
}

TEST(CudaTest, VectorAdd) {
    const std::vector<float> a      = {1.0f, 2.0f, 3.0f};
    const std::vector<float> b      = {4.0f, 5.0f, 6.0f};
    std::vector<float>       result;

    {{ namespace_name }}::vector_add(a, b, result);

    ASSERT_EQ(result.size(), 3u);
    EXPECT_FLOAT_EQ(result[0], 5.0f);
    EXPECT_FLOAT_EQ(result[1], 7.0f);
    EXPECT_FLOAT_EQ(result[2], 9.0f);
}

TEST(CudaTest, VectorAddSizeMismatch) {
    const std::vector<float> a = {1.0f, 2.0f};
    const std::vector<float> b = {1.0f};
    std::vector<float>       result;

    EXPECT_THROW({{ namespace_name }}::vector_add(a, b, result), std::invalid_argument);
}
