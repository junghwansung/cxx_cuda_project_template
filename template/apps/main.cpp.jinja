#include <iostream>
#include <vector>
#include <spdlog/spdlog.h>
#include "math.hpp"
#include "utility.hpp"
#include "vector_kernel.cuh"

int main() {
    spdlog::info("Starting {{ namespace_name }}");

    const auto msg = {{ namespace_name }}::greet("World");
    std::cout << msg << "\n";

    const int sum = {{ namespace_name }}::add(3, 4);
    spdlog::info("3 + 4 = {}", sum);

    // CUDA vector addition
    const std::vector<float> a = {1.0f, 2.0f, 3.0f, 4.0f};
    const std::vector<float> b = {10.0f, 20.0f, 30.0f, 40.0f};
    std::vector<float> result;

    {{ namespace_name }}::vector_add(a, b, result);

    spdlog::info("CUDA vector addition result:");
    for (std::size_t i = 0; i < result.size(); ++i) {
        spdlog::info("  [{0}] {1:.1f} + {2:.1f} = {3:.1f}", i, a[i], b[i], result[i]);
    }

    return 0;
}
