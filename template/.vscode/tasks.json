{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (Debug)",
            "type": "shell",
            "command": "cmake --preset default-debug",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "CMake: configure (Release)",
            "type": "shell",
            "command": "cmake --preset default-release",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "CMake: build (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "internalConsoleOptions": "neverOpen",
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: build (Release)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "group": "build",
            "internalConsoleOptions": "neverOpen",
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: clean all",
            "type": "shell",
            "command": "rm -rf ${workspaceFolder}/build",
            "problemMatcher": []
        }{% if include_google_test %},
        {
            "label": "CTest: run all (Debug)",
            "type": "shell",
            "command": "ctest --preset debug --output-on-failure",
            "group": "test",
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "CTest: run all (Release)",
            "type": "shell",
            "command": "ctest --preset release --output-on-failure",
            "group": "test",
            "dependsOn": "CMake: build (Release)",
            "problemMatcher": []
        }{% endif %}
    ]
}
