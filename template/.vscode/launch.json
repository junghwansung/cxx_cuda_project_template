{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug ({{ compiler }})",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/apps/{{ project_slug }}_app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "{% if compiler == 'gcc' %}gdb{% else %}lldb{% endif %}",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "{% if compiler == 'gcc' %}/usr/bin/gdb{% else %}/usr/bin/lldb{% endif %}",
            "preLaunchTask": "CMake: build (Debug)"
        }
    ]
}
