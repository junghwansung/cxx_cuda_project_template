if(NOT {{ project_slug }}_BUILD_DOCS)
    return()
endif()

find_package(Doxygen)

if(DOXYGEN_FOUND)
    # Doxyfile.in의 @변수@들을 현재 CMake 변수 값으로 치환하여 Doxyfile 생성
    configure_file(${CMAKE_CURRENT_SOURCE_DIR}/Doxyfile.in
                   ${CMAKE_CURRENT_BINARY_DIR}/Doxyfile @ONLY)

    # 'docs'라는 이름의 커스텀 타겟 추가
    add_custom_target(docs
        COMMAND ${DOXYGEN_EXECUTABLE} ${CMAKE_CURRENT_BINARY_DIR}/Doxyfile
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        COMMENT "Doxygen을 이용하여 소스 코드 문서 생성 중..."
        VERBATIM)
else()
    message(WARNING "Doxygen이 설치되어 있지 않아 문서 타겟을 생성할 수 없습니다.")
endif()
